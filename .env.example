# ==============================================================================
# VARIABLES DE ENTORNO PARA PRODUCCIÓN - CATÁLOGO DIGITAL MULTI-INQUILINO
# Copia este archivo como `.env` para desarrollo local o configura estas
# variables en el panel de tu proveedor cloud (Render, Railway, Fly.io, etc.).
# ==============================================================================

# 1. Credenciales Críticas de Supabase (OBLIGATORIAS)
# Obtén estos valores en: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://tu-id-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_clave_anon_o_publishable_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_clave_secret_o_service_role_aqui

# 2. Configuración del Servidor HTTP
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
PAYLOAD_LIMIT=10mb

# 3. Seguridad CORS y Dominios Frontend (OPCIONALES)
# Lista separada por comas de dominios permitidos en producción (ej: https://catalogo.tudominio.com).
# Si se deja vacío, se permiten orígenes dinámicos HTTPS y localhost en desarrollo.
FRONTEND_URL=

# URL base pública de la API si el frontend estático se aloja en otro dominio (ej: https://api.tudominio.com).
# Déjalo vacío cuando Express sirva tanto la API como las vistas estáticas en el mismo servidor.
PUBLIC_API_URL=

# 4. Seguridad de Sesiones del Panel Super-Administrador (OPCIONAL)
# Las credenciales del Super-Administrador se crean directamente desde /login en el primer ingreso
# y se almacenan de forma segura en Supabase. Opcionalmente puedes fijar una clave de firma para tokens:
SESSION_SECRET=
